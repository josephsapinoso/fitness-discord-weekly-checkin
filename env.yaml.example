# Environment variables for `gcloud run deploy --env-vars-file env.yaml`
# Copy to env.yaml, fill in real values. env.yaml is gitignored — never commit it.
#
# Note: every value must be a YAML string. The credentials JSON must be wrapped
# in single quotes.

DISCORD_TOKEN: "your-bot-token-here"
DISCORD_APPLICATION_ID: "123456789012345678"
DISCORD_PUBLIC_KEY: "abcdef0123456789..."
CHECKIN_CHANNEL_ID: "123456789012345678"
GOOGLE_SHEET_ID: "your-spreadsheet-id-here"
GOOGLE_SHEET_TAB: "Check-ins"
GOOGLE_PHOTOS_TAB: "Photos"
GOOGLE_PHOTO_LOG_TAB: "Photo Log"

# Private, bot-only channel retaining raw progress photos for /collage and
# /photo-replace. Omit to switch those off; check-ins work either way.
ARCHIVE_CHANNEL_ID: ""
GOOGLE_CREDENTIALS_JSON: '{"type":"service_account","project_id":"..."}'
TASK_SECRET: "generate-with: openssl rand -hex 32"
TASKS_LOCATION: "us-west1"
TASKS_QUEUE: "discord-followups"
