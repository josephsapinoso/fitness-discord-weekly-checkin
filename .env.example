# ── Discord ────────────────────────────────────────────────────────────────────
# All three come from https://discord.com/developers/applications → your app
# Bot token: Bot tab → Reset Token
DISCORD_TOKEN=your-bot-token-here

# Application ID: General Information tab
DISCORD_APPLICATION_ID=123456789012345678

# Public Key: General Information tab (used to verify interaction signatures)
DISCORD_PUBLIC_KEY=abcdef0123456789...

# Right-click the check-in channel in Discord (with Developer Mode on) → Copy ID
CHECKIN_CHANNEL_ID=123456789012345678

# ── Google Sheets ──────────────────────────────────────────────────────────────
# Spreadsheet ID from the URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# Name of the tab inside the sheet (created automatically if missing)
GOOGLE_SHEET_TAB=Check-ins

# Paste the full contents of your service account credentials JSON here
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Cloud Run / Cloud Tasks / Cloud Scheduler ──────────────────────────────────
# Shared secret protecting the /process and /reminder endpoints.
# Generate one with:  openssl rand -hex 32
TASK_SECRET=generate-a-long-random-string

# Cloud Tasks queue (created in docs/GCP_DEPLOY.md)
TASKS_LOCATION=us-west1
TASKS_QUEUE=discord-followups

# Optional overrides — normally auto-detected on Cloud Run:
# GOOGLE_CLOUD_PROJECT=your-project-id
# SELF_URL=https://your-service-xyz-uw.a.run.app

# The weekly reminder schedule now lives in Cloud Scheduler (not env vars) —
# see docs/GCP_DEPLOY.md step 6.
